			"use surrealdb::{engine::remote::ws::Client, Surreal};",
			"",
			"use crate::entity::${1:Entity};",
			"",
			"#[derive(Deserialize)]",
			"pub struct ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/} {",
			"\t$0",
			"}",
			"",
