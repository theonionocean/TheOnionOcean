{
	"conventionalCommits.scopes": [
		"global",
		"lib/rust/mediatr",
		"lib/rust/surrealdb_extensions",
		"lib/rust/macros_abstraction",
		"lib/rust/macros_derive",
		"lib/rust/macros_security",
		"lib/rust/macros_security_core",
		"prutaj_board",
		"infra"
	],
	"direnv.restart.automatic": true,
	"rust-analyzer.server.path": "rust-analyzer",
	"terminal.integrated.env.linux": {
		"PATH": "${env:HOME}/.local/bin:${env:PATH}"
	},
	"terminal.integrated.automationProfile.linux": {
		"path": "direnv",
		"args": ["exec", "${workspaceFolder}", "/run/current-system/sw/bin/bash"]
	}
}
